DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tepatwaktu
BETTER_AUTH_SECRET=ganti-dengan-random-secret-minimal-32-karakter
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Object storage S3-compatible. Konfigurasi ini langsung dapat digunakan
# untuk MinIO lokal dan dapat diarahkan ke AWS S3, Cloudflare R2, Wasabi, dll.
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=tepatwaktu-private
OBJECT_STORAGE_ACCESS_KEY=tepatwaktu-local
OBJECT_STORAGE_SECRET_KEY=ganti-password-minio-minimal-8-karakter
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_AUTO_CREATE_BUCKET=true

# Geocoder dapat diganti ke instance Nominatim milik sendiri atau provider kompatibel.
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=TepatWaktu/0.1

# Semua provider dengan key terisi digabung dengan Nominatim.
# Docker Compose dan Next.js lokal membaca key dari file .env.local.
GEOAPIFY_API_KEY=
TOMTOM_API_KEY=

# Email keluar: verifikasi akun, reset password, dan pengingat langganan H-5 / H-2.
# Layanan dicoba berurutan sesuai MAIL_PROVIDERS. Layanan yang kuota hariannya habis dilewati
# sampai kuota reset (00.00 UTC = 08.00 WITA), lalu otomatis dipakai lagi.
MAIL_FROM="TepatWaktu <no-reply@tepatwaktu.local>"
# Lokal: Mailpit (http://localhost:8025), email tidak benar-benar terkirim.
MAIL_PROVIDERS=mailpit
SMTP_MAILPIT_HOST=localhost
SMTP_MAILPIT_PORT=1025
# Produksi: MAIL_PROVIDERS=brevo,mailjet,mailtrap
SMTP_BREVO_HOST=smtp-relay.brevo.com
SMTP_BREVO_PORT=587
SMTP_BREVO_SECURE=false
SMTP_BREVO_USER=
SMTP_BREVO_PASS=
SMTP_BREVO_DAILY_LIMIT=300
SMTP_MAILJET_HOST=in-v3.mailjet.com
SMTP_MAILJET_PORT=587
SMTP_MAILJET_SECURE=false
SMTP_MAILJET_USER=
SMTP_MAILJET_PASS=
SMTP_MAILJET_DAILY_LIMIT=200
SMTP_MAILTRAP_HOST=live.smtp.mailtrap.io
SMTP_MAILTRAP_PORT=587
SMTP_MAILTRAP_SECURE=false
SMTP_MAILTRAP_USER=
SMTP_MAILTRAP_PASS=
SMTP_MAILTRAP_DAILY_LIMIT=150
# Opsional per layanan: SMTP_<NAMA>_FROM (default MAIL_FROM). Alamat pengirim harus domain yang terverifikasi di layanan itu.
# Opsional: cron eksternal memanggil /api/cron/subscription-reminders dengan header Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
# off = matikan penjadwal per jam di dalam aplikasi
REMINDER_SCHEDULER=on

# Header yang berisi IP asli pengunjung, diisi oleh reverse proxy (bukan oleh browser).
# Coolify/Traefik: x-real-ip (default). Domain lewat proxy Cloudflare (awan oranye): cf-connecting-ip.
CLIENT_IP_HEADER=x-real-ip

# Midtrans Snap (pembayaran paket). Ambil di dashboard Midtrans → Settings → Access Keys.
# Sandbox: dashboard.sandbox.midtrans.com, MIDTRANS_IS_PRODUCTION=false. Live: dashboard.midtrans.com, true.
# Kosongkan untuk menonaktifkan pembayaran online (invoice diverifikasi manual oleh superadmin).
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
