DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tepatwaktu
BETTER_AUTH_SECRET=ganti-dengan-random-secret-minimal-32-karakter
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Auth: Project Settings > API. Publishable key aman untuk browser.
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Hanya untuk akun Google Better Auth lama, jika masih diperlukan.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Object storage S3-compatible. Konfigurasi ini langsung dapat digunakan
# untuk MinIO lokal dan dapat diarahkan ke AWS S3, Cloudflare R2, Wasabi, dll.
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=tepatwaktu-private
OBJECT_STORAGE_ACCESS_KEY=tepatwaktu-local
OBJECT_STORAGE_SECRET_KEY=ganti-password-minio-minimal-8-karakter
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_AUTO_CREATE_BUCKET=true

# Geocoder dapat diganti ke instance Nominatim milik sendiri atau provider kompatibel.
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=TepatWaktu/0.1

# Semua provider dengan key terisi digabung dengan Nominatim.
# Docker Compose dan Next.js lokal membaca key dari file .env.local.
GEOAPIFY_API_KEY=
TOMTOM_API_KEY=
